<Project Sdk="Microsoft.NET.Sdk">
  <!-- kokoro-tts: python-free Kokoro TTS over ONNX Runtime (.NET).
       Backend = ORT (CPU here; DirectML/CUDA EPs are a SessionOptions away). Same
       Init/Run/Dispose shape as chatterbox_trt.cpp, so a TRT C-ABI bridge or a QNN
       .bin runner drops in behind the IKokoroBackend seam. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kokoro-tts</AssemblyName>
    <RootNamespace>Kokoro.Tts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
</Project>
