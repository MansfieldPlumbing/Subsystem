<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <StartupObject>AgentBrowser.Program</StartupObject>
    <AssemblyName>agent-browser</AssemblyName>
    <RootNamespace>AgentBrowser</RootNamespace>
    <Version>0.4.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="agent-browser.config.ini" Condition="Exists('agent-browser.config.ini')">
      <LogicalName>agent_browser.config.ini</LogicalName>
    </EmbeddedResource>
    <None Include="agent-browser.config.ini" Condition="Exists('agent-browser.config.ini')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="WebView2Runtime\webview2-fixed.zip" Condition="Exists('WebView2Runtime\webview2-fixed.zip')">
      <LogicalName>agent_browser.webview2_fixed.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
