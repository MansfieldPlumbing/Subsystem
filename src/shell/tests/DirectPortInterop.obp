<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>DirectPort Interop Test</title>
<style>
html, body {
  margin: 0; height: 100%;
  background: #0b0f1a; color: #9fb3c8;
  font: 13px/1.5 system-ui, sans-serif;
  overflow: hidden;
}
#c { width: 100%; height: 100%; display: block; }
#hud {
  position: fixed; top: 8px; left: 10px;
  opacity: .7; pointer-events: none;
}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="hud">DirectPort interop — waiting for region…</div>
<script>
const cv  = document.getElementById('c');
const hud = document.getElementById('hud');
const g   = cv.getContext('2d');

function fit() {
  cv.width  = cv.clientWidth  * devicePixelRatio;
  cv.height = cv.clientHeight * devicePixelRatio;
}
addEventListener('resize', fit);
fit();

addEventListener('ssframe', ev => {
  const { region: r, frame: f, manifest: m } = ev.detail;
  const n = r.length;
  g.clearRect(0, 0, cv.width, cv.height);
  g.beginPath();
  for (let i = 0; i < n; i++) {
    const x = i / (n - 1) * cv.width;
    const y = (1 - r[i]) * cv.height;
    i ? g.lineTo(x, y) : g.moveTo(x, y);
  }
  g.strokeStyle = '#4ea1ff';
  g.lineWidth   = 2 * devicePixelRatio;
  g.stroke();
  hud.textContent =
    `DirectPort interop — region '${m.region}' (${n} Float32) · frame ${f} · zero socket`;
});
</script>
</body>
</html>
