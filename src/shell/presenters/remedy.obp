<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <base href="/">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CRQ/EOS Request Hive Dashboard</title>

    <link rel="stylesheet" href="/theme.css">
    <script src="/themes.js"></script>
    <script src="/shell/presenter.js"></script>

    <style>
        * { box-sizing: border-box; }
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background: var(--bg, #000); color: var(--fg, #f2f2f2);
            font-family: var(--font-sans, sans-serif); overflow: hidden;
            user-select: none; -webkit-user-select: none;
            font-size: 13px;
        }

        /* App Layout (Win32 Split View) */
        .app-layout {
            display: flex;
            flex-direction: column;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
        }

        /* Retro Filter Panel / Toolbar */
        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--surface, #111);
            border-bottom: 1px solid var(--border, rgba(255,255,255,0.1));
            padding: 8px 16px;
            height: 52px;
            flex-shrink: 0;
            flex-wrap: nowrap;
            overflow-x: auto;
        }
        .toolbar-group {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .divider {
            width: 1px;
            height: 20px;
            background: var(--border, rgba(255,255,255,0.15));
            margin: 0 4px;
        }
        .search-input {
            background: var(--bg, #000);
            border: 1px solid var(--border, rgba(255,255,255,0.2));
            color: var(--fg, #f2f2f2);
            padding: 5px 10px;
            border-radius: 4px;
            font-size: 12px;
            width: 200px;
            outline: none;
            font-family: var(--font-sans);
        }
        .search-input:focus {
            border-color: var(--accent);
        }

        /* Filter Pills */
        .filter-btn {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            color: var(--muted);
            padding: 4px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 600;
            transition: all 0.15s;
        }
        .filter-btn:hover {
            background: rgba(255,255,255,0.1);
            color: var(--fg);
        }
        .filter-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: var(--accent-fg, #fff);
        }

        /* Severity Chips */
        .severity-pill {
            display: inline-flex;
            align-items: center;
            padding: 2px 6px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: 700;
            font-family: var(--font-mono, monospace);
        }
        .sev-1 { background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
        .sev-2 { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.3); }
        .sev-3 { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }

        /* Status Badges */
        .status-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 99px;
            font-size: 10px;
            font-weight: 600;
        }
        .status-open { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.25); }
        .status-closed { background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.25); }

        /* Main Workspace Splitted Left/Right */
        .workspace {
            display: flex;
            flex: 1;
            overflow: hidden;
            background: var(--bg);
        }

        /* Left Side List */
        .request-list-pane {
            width: 42%;
            border-right: 1px solid var(--border, rgba(255,255,255,0.1));
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .pane-header {
            padding: 6px 12px;
            background: var(--surface, #111);
            border-bottom: 1px solid var(--border, rgba(255,255,255,0.08));
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--muted, #878787);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .scrollable-list {
            flex: 1;
            overflow-y: auto;
        }
        .request-item {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border, rgba(255,255,255,0.05));
            cursor: pointer;
            transition: background 0.15s;
        }
        .request-item:hover {
            background: rgba(255, 255, 255, 0.03);
        }
        .request-item.active {
            background: color-mix(in srgb, var(--accent) 12%, transparent);
            border-left: 3px solid var(--accent);
        }
        .item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }
        .item-id {
            font-family: var(--font-mono, monospace);
            font-weight: 600;
            color: var(--muted);
        }
        .item-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--fg);
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .item-desc {
            font-size: 12px;
            color: var(--muted);
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
        }

        /* Right Side Details Pane */
        .details-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #050505;
        }
        .details-header {
            padding: 20px;
            background: var(--surface, #111);
            border-bottom: 1px solid var(--border);
        }
        .details-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Meta properties list */
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 12px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            padding: 14px;
        }
        .meta-label {
            font-size: 10px;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.05em;
            margin-bottom: 2px;
        }
        .meta-value {
            font-size: 12px;
            font-weight: 600;
            color: var(--fg);
            font-family: var(--font-mono, monospace);
        }

        /* Eos Log Console */
        .log-console {
            background: #000;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-family: var(--font-mono, monospace);
            font-size: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .log-header {
            padding: 6px 12px;
            background: #111;
            border-bottom: 1px solid #222;
            font-size: 11px;
            color: var(--muted);
            display: flex;
            justify-content: space-between;
        }
        .log-lines {
            padding: 12px;
            max-height: 250px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .log-line {
            display: flex;
            gap: 8px;
            line-height: 1.5;
            white-space: pre-wrap;
        }
        .log-time { color: var(--muted); flex-shrink: 0; }
        .log-lvl { font-weight: bold; flex-shrink: 0; }
        .lvl-info { color: var(--accent); }
        .lvl-warn { color: #f59e0b; }
        .lvl-error { color: #ef4444; }

        /* Files List box */
        .file-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 4px;
            padding: 8px 12px;
            margin-bottom: 6px;
        }

        /* Empty state */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--muted);
            gap: 12px;
        }

        /* Scrollbar styles */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    </style>
</head>
<body>
    <div class="app-layout">
        <!-- Dashboard Filters -->
        <div class="toolbar">
            <div class="toolbar-group">
                <!-- Search Box -->
                <input type="text" id="search-box" class="search-input" placeholder="Search SUMMARY / EOSLOGS...">

                <div class="divider"></div>

                <!-- Status Filters -->
                <button class="filter-btn active" data-status="All">All Statuses</button>
                <button class="filter-btn" data-status="Open">Open</button>
                <button class="filter-btn" data-status="Closed">Closed</button>

                <div class="divider"></div>

                <!-- Severity Filters Toggle Group -->
                <button class="filter-btn active" id="filter-sev1" data-sev="1">Sev 1</button>
                <button class="filter-btn active" id="filter-sev2" data-sev="2">Sev 2</button>
                <button class="filter-btn active" id="filter-sev3" data-sev="3">Sev 3</button>

                <div class="divider"></div>

                <!-- Category Selector -->
                <button class="filter-btn active" data-cat="All">All Categories</button>
                <span id="category-pills" style="display: flex; gap: 6px;"></span>
            </div>
            <div class="toolbar-group">
                <button id="tb-refresh" class="filter-btn" style="color: var(--success);">
                    <span style="font-family: var(--font-mono); margin-right: 4px;">&#xf021;</span>
                    <span>Sync Hive</span>
                </button>
            </div>
        </div>

        <!-- Splitted workspace -->
        <div class="workspace">
            <!-- Left panel: List -->
            <div class="request-list-pane">
                <div class="pane-header">
                    <span>CRQ REQUEST INDEX</span>
                    <span id="list-count" style="color: var(--accent); font-family: var(--font-mono);">-- Requests</span>
                </div>
                <div class="scrollable-list" id="request-list-container">
                    <!-- Dynamically loaded -->
                </div>
            </div>

            <!-- Right panel: Details -->
            <div class="details-pane" id="details-container">
                <!-- Dynamically loaded -->
                <div class="empty-state">
                    <span style="font-size: 24px; font-family: var(--font-mono);">&#xf03e;</span>
                    <span>Select a CRQ Request to load EOS Log entries and telemetry files</span>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        let allRequests = [];
        let filteredRequests = [];
        let selectedId = null;

        // Active filter state
        let searchQuery = "";
        let statusFilter = "All";
        let activeSeverities = { 1: true, 2: true, 3: true };
        let categoryFilter = "All";

        // Utilities
        function formatDate(sec) {
            return new Date(sec * 1000).toLocaleString();
        }

        // Data Fetching
        async function fetchRequests() {
            try {
                const res = await fetch("/api/crq/requests");
                allRequests = await res.json();
                
                // Extract unique categories
                buildCategoryFilters();

                // Select first if null
                if (allRequests.length > 0 && selectedId === null) {
                    selectedId = allRequests[0].Id;
                }

                applyFilters();
            } catch (err) {
                console.error("Failed to load requests", err);
            }
        }

        function buildCategoryFilters() {
            const categories = new Set();
            allRequests.forEach(r => { if (r.Category) categories.add(r.Category); });

            const wrapper = document.getElementById("category-pills");
            let html = "";
            categories.forEach(cat => {
                html += `<button class="filter-btn" data-cat="${cat}">${cat}</button>`;
            });
            wrapper.innerHTML = html;

            // Bind events to dynamically built category buttons
            document.querySelectorAll("[data-cat]").forEach(btn => {
                btn.onclick = () => {
                    document.querySelectorAll("[data-cat]").forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    categoryFilter = btn.getAttribute("data-cat");
                    applyFilters();
                };
            });
        }

        // Apply search, severity, category, and status filtering
        function applyFilters() {
            filteredRequests = allRequests.filter(req => {
                // Status match
                if (statusFilter !== "All" && req.Status !== statusFilter) return false;

                // Category match
                if (categoryFilter !== "All" && req.Category !== categoryFilter) return false;

                // Severity match
                if (!activeSeverities[req.Severity]) return false;

                // Search query match (summary, details, logs)
                if (searchQuery) {
                    const q = searchQuery.toLowerCase();
                    const textSource = `${req.Id} ${req.Summary} ${req.Description} ${req.Category} ${req.TargetNode}`.toLowerCase();
                    let logMatch = false;
                    if (req.EosLogs) {
                        logMatch = req.EosLogs.some(log => log.Message.toLowerCase().includes(q));
                    }
                    if (!textSource.includes(q) && !logMatch) return false;
                }

                return true;
            });

            document.getElementById("list-count").innerText = `${filteredRequests.length} Requests`;
            renderList();
            renderSelectedDetails();
        }

        // Render List Panel
        function renderList() {
            const container = document.getElementById("request-list-container");
            if (filteredRequests.length === 0) {
                container.innerHTML = `
                    <div class="empty-state" style="padding: 40px 10px;">
                        <span>No requests matched your filter criteria</span>
                    </div>
                `;
                return;
            }

            let html = "";
            filteredRequests.forEach(req => {
                const isActive = req.Id === selectedId;
                const statusClass = req.Status === "Open" ? "status-open" : "status-closed";
                const dateStr = formatDate(req.Timestamp);

                html += `
                    <div class="request-item ${isActive ? "active" : ""}" data-id="${req.Id}">
                        <div class="item-row">
                            <span class="item-id">CRQ-${req.Id}</span>
                            <span class="severity-pill sev-${req.Severity}">SEV ${req.Severity}</span>
                        </div>
                        <div class="item-row" style="margin-top: 4px;">
                            <span class="item-title">${req.Summary}</span>
                        </div>
                        <div class="item-row">
                            <span class="item-desc">${req.Description || "No additional logs summary"}</span>
                        </div>
                        <div class="item-row" style="margin-top: 8px; font-size: 11px;">
                            <span style="color: var(--muted); font-family: var(--font-mono);">${dateStr}</span>
                            <span class="status-badge ${statusClass}">${req.Status.toUpperCase()}</span>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;

            // List bindings
            container.querySelectorAll(".request-item").forEach(item => {
                item.onclick = () => {
                    selectedId = parseInt(item.getAttribute("data-id"));
                    renderList();
                    renderSelectedDetails();
                };
            });
        }

        // Render Selected details panel
        function renderSelectedDetails() {
            const container = document.getElementById("details-container");
            const req = allRequests.find(r => r.Id === selectedId);

            if (!req) {
                container.innerHTML = `
                    <div class="empty-state">
                        <span style="font-size: 24px;">&#xf03e;</span>
                        <span>Select a CRQ Request from the index to view telemetry data</span>
                    </div>
                `;
                return;
            }

            const statusClass = req.Status === "Open" ? "status-open" : "status-closed";
            const dateStr = formatDate(req.Timestamp);

            // Log Console lines
            let logHtml = "";
            if (req.EosLogs && req.EosLogs.length > 0) {
                req.EosLogs.forEach(log => {
                    const timeStr = new Date(log.Timestamp * 1000).toLocaleTimeString();
                    const lvlColor = log.Level === "ERROR" ? "lvl-error" : (log.Level === "WARN" ? "lvl-warn" : "lvl-info");
                    logHtml += `
                        <div class="log-line">
                            <span class="log-time">[${timeStr}]</span>
                            <span class="log-lvl ${lvlColor}">${log.Level}</span>
                            <span>${log.Message}</span>
                        </div>
                    `;
                });
            } else {
                logHtml = `<div style="color: var(--muted); padding: 12px; text-align: center;">No registered CoreCLR logging events for this Request</div>`;
            }

            // Related files
            let filesHtml = "";
            if (req.RelatedFiles && req.RelatedFiles.length > 0) {
                req.RelatedFiles.forEach(file => {
                    filesHtml += `
                        <div class="file-box">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="color: var(--accent); font-family: var(--font-mono); font-size: 14px;">&#xf15b;</span>
                                <span style="font-family: var(--font-mono); font-size: 12px;">${file}</span>
                            </div>
                            <button class="filter-btn" style="padding: 2px 8px; font-size: 10px;">VIEW SOURCE</button>
                        </div>
                    `;
                });
            } else {
                filesHtml = `<div style="color: var(--muted); font-size: 11px;">No diagnostic physical file paths attached</div>`;
            }

            container.innerHTML = `
                <!-- Header of Details -->
                <div class="details-header">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                        <div>
                            <span style="font-family: var(--font-mono); font-size: 12px; color: var(--muted); font-weight: 600;">CRQ REQUEST OBJECT</span>
                            <h2 style="margin: 4px 0 0 0; font-size: 18px; font-weight: 700; color: #fff;">CRQ-${req.Id}: ${req.Summary}</h2>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <span class="severity-pill sev-${req.Severity}" style="font-size: 11px; padding: 4px 8px;">SEVERITY ${req.Severity}</span>
                            <span class="status-badge ${statusClass}" style="font-size: 11px; padding: 4px 8px;">${req.Status.toUpperCase()}</span>
                        </div>
                    </div>
                </div>

                <!-- Scrollable Body details -->
                <div class="details-body">
                    <!-- Metadata properties matrix -->
                    <div class="meta-grid">
                        <div>
                            <div class="meta-label">Category Node</div>
                            <div class="meta-value" style="color: var(--accent);">${req.Category || "Core"}</div>
                        </div>
                        <div>
                            <div class="meta-label">Host target</div>
                            <div class="meta-value">${req.TargetNode || "ss.exe"}</div>
                        </div>
                        <div>
                            <div class="meta-label">Dispatched At</div>
                            <div class="meta-value" style="font-size: 11px;">${dateStr}</div>
                        </div>
                        <div>
                            <div class="meta-label">Dispatched ID</div>
                            <div class="meta-value" style="color: var(--success);">${req.RequestedBy || "System Core"}</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div>
                        <h3 style="margin: 0 0 8px 0; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">Description</h3>
                        <p style="margin: 0; line-height: 1.6; font-size: 13px; color: #ddd;">${req.Description}</p>
                    </div>

                    <!-- Eos Log console output -->
                    <div>
                        <h3 style="margin: 0 0 8px 0; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">CORECLR EOS LOG</h3>
                        <div class="log-console">
                            <div class="log-header">
                                <span>TERMINAL LOG DISPATCH OVERLAY</span>
                                <span>RAW BYTES STATED</span>
                            </div>
                            <div class="log-lines">
                                ${logHtml}
                            </div>
                        </div>
                    </div>

                    <!-- Telemetry Files -->
                    <div>
                        <h3 style="margin: 0 0 8px 0; font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted);">ASSOCIATED FILES</h3>
                        <div style="display: flex; flex-direction: column;">
                            ${filesHtml}
                        </div>
                    </div>
                </div>
            `;
        }

        // Filter Actions Hookups
        document.getElementById("search-box").addEventListener("input", (e) => {
            searchQuery = e.target.value;
            applyFilters();
        });

        // Status filters click handler
        document.querySelectorAll("[data-status]").forEach(btn => {
            btn.onclick = () => {
                document.querySelectorAll("[data-status]").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                statusFilter = btn.getAttribute("data-status");
                applyFilters();
            };
        });

        // Severity toggles
        document.getElementById("filter-sev1").onclick = (e) => {
            e.target.classList.toggle("active");
            activeSeverities[1] = e.target.classList.contains("active");
            applyFilters();
        };
        document.getElementById("filter-sev2").onclick = (e) => {
            e.target.classList.toggle("active");
            activeSeverities[2] = e.target.classList.contains("active");
            applyFilters();
        };
        document.getElementById("filter-sev3").onclick = (e) => {
            e.target.classList.toggle("active");
            activeSeverities[3] = e.target.classList.contains("active");
            applyFilters();
        };

        // Sync Refresh Click
        document.getElementById("tb-refresh").onclick = () => fetchRequests();

        // Load initially
        fetchRequests();
    </script>
</body>
</html>
