<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon long-press shortcuts. Each targets an existing door activity-alias by explicit component
     name; MainActivity.DoorFromIntent reads the ".door.<Id>" suffix and loads that door full-bleed.
     No new routing code — this rides the lane the manifest comment already anticipated. Launchers show
     up to 4 static shortcuts; these are the four doors. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="terminal"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/sc_terminal_short"
        android:shortcutLongLabel="@string/sc_terminal_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="dev.mansfieldplumbing.subsystem"
            android:targetClass="dev.mansfieldplumbing.subsystem.door.Terminal" />
    </shortcut>
    <shortcut
        android:shortcutId="editor"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/sc_editor_short"
        android:shortcutLongLabel="@string/sc_editor_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="dev.mansfieldplumbing.subsystem"
            android:targetClass="dev.mansfieldplumbing.subsystem.door.Editor" />
    </shortcut>
    <shortcut
        android:shortcutId="broker"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/sc_broker_short"
        android:shortcutLongLabel="@string/sc_broker_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="dev.mansfieldplumbing.subsystem"
            android:targetClass="dev.mansfieldplumbing.subsystem.door.Broker" />
    </shortcut>
    <shortcut
        android:shortcutId="settings"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/sc_settings_short"
        android:shortcutLongLabel="@string/sc_settings_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="dev.mansfieldplumbing.subsystem"
            android:targetClass="dev.mansfieldplumbing.subsystem.door.Settings" />
    </shortcut>
</shortcuts>
