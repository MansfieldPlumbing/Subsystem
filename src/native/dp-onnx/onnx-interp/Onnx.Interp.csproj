<Project Sdk="Microsoft.NET.Sdk">
  <!-- dp-onnx: native .NET ONNX interpreter over Onnx.dll (protobuf decomposition of the
       ONNX schema). NO onnxruntime. Vendored into subsystem (CRQ143 P0): onnxnet is a sibling
       ProjectReference, not a HintPath'd DLL — the repo's Directory.Build.props redirects build
       output to a build/ sibling, so a fixed bin\ HintPath cannot resolve; the project graph can.
       EnableDefaultCompileItems stays false so emitted/scratch .cs (io\*.cs) are never swept in. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dp-onnx</AssemblyName>
    <!-- single-file project: compile ONLY Program.cs so emitted/scratch .cs (io\*.cs, _emittest\**) under the tree are never swept in -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="..\onnxnet\Onnx.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
  </ItemGroup>
</Project>
