#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set=0, binding=0) readonly buffer ABuf { float A[]; };
layout(set=0, binding=1) readonly buffer BBuf { float B[]; };
layout(set=0, binding=2)          buffer CBuf { float C[]; };
layout(push_constant) uniform PC { uint M; uint N; uint K; } pc;
void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;
    if (row >= pc.M || col >= pc.N) return;
    float acc = 0.0;
    for (uint k = 0; k < pc.K; k++) acc += A[row * pc.K + k] * B[k * pc.N + col];
    C[row * pc.N + col] = acc;
}
