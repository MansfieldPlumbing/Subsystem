<Project Sdk="Microsoft.NET.Sdk">
  <!-- Onnx: the ONNX schema as hand-rolled .NET POCOs + a minimal protobuf reader/writer
       (OnnxProto.cs). No Google.Protobuf, no Grpc.Tools, no codegen — so dp-onnx folds into the
       in-proc Roslyn build (ss build self) with no NuGet dep (CRQ143). net11 = its only consumer
       (the dp-onnx interpreter). onnx.proto kept as the schema reference, not compiled. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Onnx</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <None Include="onnx.proto" />
  </ItemGroup>
</Project>
