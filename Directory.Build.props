<Project>
  <!-- Redirect ALL build output OUT of the source tree to a 'build' drive-sibling (same drive as src →
       no cross-drive dup-class). Keeps src/ pure source — bin/obj never appear under src/runspace.
       BaseIntermediateOutputPath MUST be set here (Directory.Build.props), not in the .csproj — it's read
       before obj/project.assets.json is located, so a csproj edit is too late. -->
  <PropertyGroup>
    <!-- Drive-agnostic, NO hardcoded path: $(SS_BUILD) override, else a 'build' sibling of the repo
         (same drive as src -> no cross-drive dup-class). Normalized so the '..' resolves cleanly. -->
    <SsBuild Condition="'$(SS_BUILD)' != ''">$(SS_BUILD)</SsBuild>
    <SsBuild Condition="'$(SsBuild)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build'))</SsBuild>
    <BaseIntermediateOutputPath>$(SsBuild)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(SsBuild)\$(MSBuildProjectName)\bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- Runtime right-sizing: fuse off CoreCLR cruft modules across BOTH heads (the toxic diagnostic
       thread + EventSource/ETW + managed-debugger attach + HTTP activity tracing + hot-reload + the
       obsolete BinaryFormatter). EventSourceSupport=false is proven safe — the Android head ships it
       and the app runs. KEPT deliberately: StackTraceSupport (Dg needs traces), BuiltInComInteropSupport
       (WebView2 + the PE-factory COM vtables), readable exception text. Measure-then-decide (risky/big):
       InvariantGlobalization, PublishTrimmed (pwsh trims badly). -->
  <PropertyGroup>
    <EnableEventPipe>false</EnableEventPipe>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
</Project>
